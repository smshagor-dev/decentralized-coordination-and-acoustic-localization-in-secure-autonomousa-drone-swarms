# Real drone runtime toggle
REAL_DRONE_ENABLED=0

# Format: drone_id=connection,drone_id=connection
# Examples:
#   REAL_DRONE_CONNECTIONS=1=udpin://:14540,2=udpin://:14541
#   REAL_DRONE_CONNECTIONS=1=serial:///dev/ttyACM0:921600
REAL_DRONE_CONNECTIONS=1=udpin://:14540

# Local origin used for local<->GPS conversion
REAL_GPS_REF_LAT=23.8103
REAL_GPS_REF_LON=90.4125

# C++ sensor connection profile (DroneController)
SENSOR_MOTOR_RPM_ENABLED=1
SENSOR_MOTOR_RPM_CONNECTION=mavlink://esc_telemetry
SENSOR_MOTOR_RPM_RATE_HZ=50

SENSOR_BATTERY_ENABLED=1
SENSOR_BATTERY_CONNECTION=mavlink://battery_status
SENSOR_BATTERY_RATE_HZ=10

SENSOR_GPS_ENABLED=1
SENSOR_GPS_CONNECTION=mavlink://gps_raw_int
SENSOR_GPS_RATE_HZ=10

SENSOR_IMU_ENABLED=1
SENSOR_IMU_CONNECTION=mavlink://highres_imu
SENSOR_IMU_RATE_HZ=100

SENSOR_BAROMETER_ENABLED=1
SENSOR_BAROMETER_CONNECTION=mavlink://scaled_pressure
SENSOR_BAROMETER_RATE_HZ=25

SENSOR_MAGNETOMETER_ENABLED=1
SENSOR_MAGNETOMETER_CONNECTION=mavlink://raw_imu.mag
SENSOR_MAGNETOMETER_RATE_HZ=25

SENSOR_ACOUSTIC_ENABLED=0
SENSOR_ACOUSTIC_CONNECTION=udp://0.0.0.0:16060
SENSOR_ACOUSTIC_RATE_HZ=48000

# Real map provider toggle for GUI Acoustic Real Map (0=off, 1=on)
MAP_USE_FREE=1
MAP_USE_YANDEX=0
MAP_USE_GOOGLE=0

# Secrets (optional)
MAP_YANDEX_API_KEY=
MAP_GOOGLE_API_KEY=
